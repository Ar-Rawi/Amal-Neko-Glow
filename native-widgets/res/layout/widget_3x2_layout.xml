<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row: Title + Add Button + Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Amal Neko"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- + Add Button -->
        <ImageView
            android:id="@+id/widget_add_btn"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_add"
            android:contentDescription="Add task" />

        <TextView
            android:id="@+id/widget_progress_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="3x2 Study"
            android:textColor="#ff75c3"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Task ListView -->
    <ListView
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="12dp" />

    <!-- Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="By Rawi"
        android:textColor="#818cf8"
        android:textSize="9sp" />
</LinearLayout>
